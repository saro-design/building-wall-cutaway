// Cloudflare Workers config, used by Workers Builds on every push to main
// (build: python3 build/build.py, deploy: npx wrangler deploy).
// Static site only: dist/ is served as-is, including dist/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "building-cutaway",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": { "directory": "dist" },
  // Served only on the custom domain; the *.workers.dev address and preview URLs are off.
  "routes": [{ "pattern": "cutaway.sarvesh.co.uk", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
